# Opcional: Compose usa estos valores por defecto si no existe un archivo .env.
COMPOSE_PROJECT_NAME=rutasur
KAFKA_EXTERNAL_PORT=19092
MONGODB_EXTERNAL_PORT=27028
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
MONGODB_URI=mongodb://localhost:27028/rutasur?replicaSet=rs0&directConnection=true

# Parámetros del simulador de RutaSur.
SIMULATOR_SEED=2026
SIMULATOR_START_AT=2026-10-18T08:00:00.000Z
SIMULATOR_ACCELERATION=120
SIMULATOR_SHIPMENTS_PER_MINUTE=20
SIMULATOR_ZONE_FAILURE_RATES=ZONA-NORTE=0.05,ZONA-CENTRO=0.15,ZONA-SUR=0.30
SIMULATOR_FAILURE_REASONS=AUSENTE=0.60,DIRECCION_INCORRECTA=0.20,RECHAZADO=0.15,ZONA_INACCESIBLE=0.05
SIMULATOR_HUB_DELAY_PROBABILITY=0.10
SIMULATOR_DUPLICATE_PROBABILITY=0.02
SIMULATOR_OUT_OF_ORDER_PROBABILITY=0.02
SIMULATOR_MALFORMED_PROBABILITY=0.01
# Calendario de reprogramación y fecha de indicadores: UTC-3, lunes a viernes.
BUSINESS_UTC_OFFSET_MINUTES=-180
# Lista de fechas locales separadas por comas; no se incluyen feriados por defecto.
BUSINESS_HOLIDAYS=

# Frecuencia del monitor en tiempo simulado (60 s / aceleración = intervalo real).
SLA_EVALUATION_INTERVAL_SIMULATED_MS=60000

# Interfaz y control local de escenarios.
WEB_PORT=3000
SIMULATOR_CONTROL_URL=http://127.0.0.1:3001
SIMULATOR_CONTROL_HOST=127.0.0.1
SIMULATOR_CONTROL_PORT=3001

# Vista histórica de tiempo en hub; cambiar solo al reconstruir ese indicador.
HUB_GENERATION=main
